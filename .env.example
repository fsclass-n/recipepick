# =====================================================================
# RecipePick 환경 변수 (로컬: 이 파일을 .env 로 복사 / Render·Netlify: 대시보드에 등록)
# [R] = Render 백엔드(recipepick-api) 필수   [F] = 프런트엔드(Netlify/Render Static) 필수
# =====================================================================

# ---------- 공통 / 보안 ----------
APP_ENV=development                     # [R] production
SECRET_KEY=change-me-to-a-long-random-string   # [R] JWT 서명 키 (openssl rand -hex 32)
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS 허용 오리진 (쉼표 구분)                     [R]
FRONTEND_URLS=http://localhost:5173,https://recipepick.netlify.app,https://recipepick.onrender.com
# OAuth 로그인 완료 후 돌아갈 기본 프런트엔드 주소   [R]
FRONTEND_URL=http://localhost:5173
# OAuth 콜백 생성용 백엔드 공개 주소                 [R] https://recipepick-api.onrender.com
BACKEND_URL=http://localhost:8000

# ---------- 데이터베이스 (TiDB) ----------
# TIDB_HOST 를 비워두면 로컬 SQLite(backend/data/recipepick.db)로 자동 대체됩니다.
TIDB_HOST=                              # [R] gateway01.xxx.prod.aws.tidbcloud.com
TIDB_PORT=4000                          # [R]
TIDB_USER=                              # [R] xxxx.root
TIDB_PASSWORD=                          # [R]
TIDB_DB_NAME=recipepick                 # [R]
TIDB_CA_PATH=                           # 비우면 certifi CA 번들 사용
# DATABASE_URL=mysql+pymysql://user:pass@host:3306/db   # 직접 지정 시 위 TiDB 설정보다 우선 (예: AWS RDS)
# DB_SSL_MODE=required                  # DATABASE_URL 사용 시 TLS 검증 여부. RDS 프라이빗 연결은 disabled

# S3 이미지 미러링 (비우면 외부 이미지 URL을 그대로 사용)
# S3_BUCKET=                            # 예: recipepick-deal-images
# S3_REGION=ap-northeast-2
# S3_PREFIX=deals


# 테스트 계정(일반/관리자) 자동 생성
SEED_TEST_ACCOUNTS=true

# ---------- Google Gemini ----------
GEMINI_API_KEY=                         # [R] https://aistudio.google.com/apikey
GEMINI_MODEL=gemini-3.5-flash-lite          # 단종·과부하 시 대체 모델을 순서대로 자동 시도
GEMINI_FALLBACK_MODELS=                   # 쉼표 구분 추가 대체 모델 (선택)
GEMINI_TIMEOUT_SECONDS=40

# ---------- 소셜 로그인 (OAuth) ----------
# 콜백 URL: {BACKEND_URL}/api/auth/oauth/{google|naver|kakao}/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
KAKAO_CLIENT_ID=                        # REST API 키
KAKAO_CLIENT_SECRET=

# ---------- RPA (Playwright) ----------
RPA_MODE=auto                           # live | demo | auto(실패 시 데모 데이터로 대체)
PLAYWRIGHT_HEADLESS=true
CRAWL_INTERVAL_MINUTES=60
CRAWL_ON_STARTUP=true
CRAWL_STARTUP_DELAY_SECONDS=30           # 서버 기동 후 첫 크롤링까지 대기(헬스체크 우선)
CRAWL_TIMEOUT_SECONDS=30

# ---------- 알림 웹훅 ----------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_TO=

# ---------- 프런트엔드 (Vite) ----------
VITE_API_BASE_URL=http://localhost:8000   # [F] https://recipepick-api.onrender.com
