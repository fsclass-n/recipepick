# Copy to /etc/recipepick/recipepick.env; never commit the populated file.
APP_ENV=production
SECRET_KEY=replace-with-openssl-rand-hex-32
FRONTEND_URLS=https://recipepick.duckdns.org,https://recipepick.netlify.app,https://recipepick.onrender.com
FRONTEND_URL=https://recipepick.duckdns.org
BACKEND_URL=https://recipepick.duckdns.org
TIDB_HOST=
TIDB_PORT=4000
TIDB_USER=
TIDB_PASSWORD=
TIDB_DB_NAME=recipepick
# EC2에서 TiDB 대신 AWS RDS를 쓰려면 DATABASE_URL만 설정하면 됩니다(TIDB_*보다 우선).
# 같은 VPC 프라이빗 연결이면 DB_SSL_MODE=disabled, 공인 CA가 아닌 RDS CA 검증은 지원하지 않습니다.
# DATABASE_URL=mysql+pymysql://user:pass@rds-endpoint:3306/recipepick
# DB_SSL_MODE=disabled
# DATABASE_URL과 TIDB_*를 둘 다 채우면 페일오버로 동작합니다: 주 DB(RDS) 연결
# 실패 시 자동으로 TiDB로 붙고(3초 타임아웃), 주 DB 복구 시 새 커넥션부터 자동
# 복귀합니다. 다운 기간의 쓰기는 예비 DB에만 남습니다(동기화 안 됨).
GEMINI_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
RPA_MODE=auto
PLAYWRIGHT_HEADLESS=true
